#!/usr/bin/env bash
#
# dotfiles - (re)install Alex Meade's dotfiles.
#
# Clones (or updates) ~/.dotfiles, then:
#   1. runs scripts in  init/   (install a few essential tools)
#   2. copies files from copy/   into ~/
#   3. symlinks files from link/ into ~/
#
# Files in source/ are sourced by ~/.bashrc on every new shell.
# Files in bin/ are added to $PATH.
#
# Bootstrap on a fresh machine:
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/ameade/dotfiles/my_files/bin/dotfiles)"

set -uo pipefail

DOTFILES_REPO="https://github.com/ameade/dotfiles.git"
DOTFILES_BRANCH="my_files"
DOTFILES_DIR="$HOME/.dotfiles"

# Logging helpers.
function e_header()  { echo -e "\n\033[1m$*\033[0m"; }
function e_success() { echo -e " \033[1;32m✔\033[0m  $*"; }
function e_error()   { echo -e " \033[1;31m✖\033[0m  $*"; }
function e_arrow()   { echo -e " \033[1;33m➜\033[0m  $*"; }

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'
  exit
fi

# Ensure git exists (install via apt/brew if missing).
if ! command -v git &>/dev/null; then
  if [[ "$OSTYPE" =~ ^darwin ]]; then
    e_error "git not found. Install the Xcode Command Line Tools first: xcode-select --install"
    exit 1
  elif command -v apt-get &>/dev/null; then
    e_header "Installing git"
    sudo apt-get -qq update && sudo apt-get -qq install -y git
  else
    e_error "git is required but not installed. Please install it and re-run."
    exit 1
  fi
fi

# Clone or update the repo.
if [[ ! -d "$DOTFILES_DIR" ]]; then
  new_install=1
  e_header "Cloning dotfiles into $DOTFILES_DIR"
  git clone -b "$DOTFILES_BRANCH" "$DOTFILES_REPO" "$DOTFILES_DIR"
else
  e_header "Updating dotfiles"
  git -C "$DOTFILES_DIR" pull --ff-only || e_error "Could not fast-forward; resolve manually."
fi

cd "$DOTFILES_DIR" || { e_error "Cannot cd into $DOTFILES_DIR"; exit 1; }

# Make bin scripts available for the rest of this run.
PATH="$DOTFILES_DIR/bin:$PATH"
export PATH

shopt -s nullglob

# Where overwritten files get backed up.
backup_dir="$DOTFILES_DIR/backups/$(date "+%Y_%m_%d-%H_%M_%S")"
backup=

# Back up an existing ~/ file before clobbering it.
function backup_file() {
  local dest="$1"
  if [[ -e "$dest" && ! -L "$dest" ]]; then
    backup=1
    mkdir -p "$backup_dir"
    e_arrow "Backing up ${dest/#$HOME/\~}"
    mv "$dest" "$backup_dir/"
  fi
}

# 1. init: run setup scripts (alphanumeric order). Each aborts itself if not relevant.
e_header "Running init scripts"
for script in init/*.sh; do
  source "$script"
done

# 2. copy: files that need local edits (contain personal data) get copied, not linked.
e_header "Copying files into home directory"
for file in copy/* copy/.*; do
  base="$(basename "$file")"
  [[ "$base" == "." || "$base" == ".." ]] && continue
  dest="$HOME/$base"
  # Don't clobber a copy the user has already customized.
  if [[ -e "$dest" ]] && ! cmp -s "$file" "$dest"; then
    e_arrow "Skipping ~/$base (already exists and differs — edit it directly)"
    continue
  fi
  cp "$file" "$dest"
  e_success "Copied ~/$base"
done

# 3. link: symlink dotfiles into ~/ so edits flow back to the repo.
e_header "Linking files into home directory"
for file in link/* link/.*; do
  base="$(basename "$file")"
  [[ "$base" == "." || "$base" == ".." ]] && continue
  dest="$HOME/$base"
  # Already the right symlink? Leave it.
  [[ "$dest" -ef "$file" ]] && continue
  backup_file "$dest"
  ln -sf "$file" "$dest"
  e_success "Linked ~/$base"
done

if [[ "$backup" ]]; then
  echo -e "\nBacked up pre-existing files to ${backup_dir/#$HOME/\~}"
fi

if [[ "${new_install:-}" && -e conf/firsttime_reminder.sh ]]; then
  e_header "First-time reminders"
  source conf/firsttime_reminder.sh
fi

e_header "All done! Run 'source ~/.bashrc' or open a new shell."
