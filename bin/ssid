#!/bin/bash

if [[ "$1" == "-h" || "$1" == "--help" ]]; then cat <<HELP
Get the current WiFi SSID (macOS).

Usage: $(basename "$0") [SSID]

With no argument, echo the current WiFi network's SSID. If an SSID is given,
echo it only when it matches the currently-connected network.
HELP
exit; fi

# The legacy 'airport -I' was removed in macOS 14.4; use system_profiler.
ssid=$(system_profiler SPAirPortDataType 2>/dev/null \
  | awk '/Current Network Information:/{getline; gsub(/^ +| +:$/,""); print; exit}')

# Fallback for older macOS where networksetup reports the active SSID.
if [[ -z "$ssid" ]]; then
  ssid=$(networksetup -getairportnetwork en0 2>/dev/null | sed 's/^Current Wi-Fi Network: //')
fi

if [[ "$1" ]]; then
  [[ "$ssid" == "$1" ]] && echo "$1"
else
  echo "$ssid"
fi
