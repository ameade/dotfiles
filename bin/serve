#!/usr/bin/env python3
"""Serve the current directory (or a file) over HTTP.

Usage: serve [PORT] [FILE]

If a port isn't specified, use 8080. Serves the current directory. Unless
in an SSH session, opens the URL in the default browser. Unknown file types
are served as UTF-8 text/plain so they render in-browser instead of downloading.
"""
import functools
import os
import subprocess
import sys
from http.server import SimpleHTTPRequestHandler, test

args = sys.argv[1:]

if args and args[0] in ("-h", "--help"):
    print(__doc__)
    sys.exit()

port = 8080
if args and args[0].isdigit():
    port = int(args[0])
    args = args[1:]

path = args[0] if args else ""

# Open in the default browser unless we're on a remote (SSH) session.
if "SSH_TTY" not in os.environ:
    opener = "open" if sys.platform == "darwin" else "xdg-open"
    try:
        subprocess.Popen([opener, f"http://localhost:{port}/{path}"])
    except FileNotFoundError:
        pass


class Handler(SimpleHTTPRequestHandler):
    extensions_map = {
        **SimpleHTTPRequestHandler.extensions_map,
        "": "text/plain",
    }


# Serve everything as UTF-8 so funky characters render correctly.
Handler.extensions_map = {
    k: (v if "charset=" in v else f"{v}; charset=UTF-8")
    for k, v in Handler.extensions_map.items()
}

test(HandlerClass=Handler, port=port, bind="")
