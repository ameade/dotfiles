[user]
  name = Alex Meade
  email = mr.alex.meade@gmail.com
[core]
  editor = vim
  autocrlf = input
  whitespace = fix,space-before-tab,tab-in-indent,trailing-space
  excludesfile = ~/.gitignore_global
[apply]
  whitespace = fix
[init]
  defaultBranch = main
[pull]
  ff = only
[alias]
  # Delete local branches already merged into the current branch.
  bc = !sh -c \"git branch --merged | grep -v \\\"\\*\\\" | xargs -n 1 git branch -d\"
  br = branch
  ci = commit
  co = checkout
  df = diff
  g = grep -I
  lg = log -p
  pp = !"echo 'Pull'; git pull; echo 'Push'; git push"
  st = status
[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[merge]
  log = true
